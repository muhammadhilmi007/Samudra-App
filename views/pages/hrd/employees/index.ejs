<div class="container-fluid">
  <div class="row">
    <div class="col-lg-12">
      <!-- Success/Error Messages -->
      <% if (locals.successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= successMessage %>
            <button type="button" class="btn-close text-capitalize" data-bs-dismiss="alert" aria-label="Close">
              <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg rony" aria-hidden="true">
            </button>
        </div>
        <% } %>
          <% if (locals.errorMessage) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <%= errorMessage %>
                <button type="button" class="btn-close text-capitalize" data-bs-dismiss="alert" aria-label="Close">
                  <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg rony" aria-hidden="true">
                </button>
            </div>
            <% } %>

              <div class="breadcrumb-main">
                <h4 class="text-capitalize breadcrumb-title"><%- __('Employees') %></h4>
                <div class="breadcrumb-action justify-content-center flex-wrap">
                  <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                      <li class="breadcrumb-item">
                        <a href="<%= locals.base %>dashboard/analytics/<%- locale %>"><i class="las la-home"></i><%-
                            __('dashboard-menu-title') %></a>
                      </li>
                      <li class="breadcrumb-item"><a href="#">HRD</a></li>
                      <li class="breadcrumb-item active" aria-current="page"><%- __('Employees') %></li>
                    </ol>
                  </nav>
                </div>
              </div>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="ap-po-details p-3 radius-xl bg-white d-flex justify-content-between">
        <div>
          <div class="overview-content">
            <h1>
              <%= statistics.total %>
            </h1>
            <p>Total Employees</p>
          </div>
        </div>
        <div class="ap-po-timeChart">
          <div class="overview-single__chart d-md-flex align-items-end">
            <div class="color-primary">
              <i class="las la-users fs-40"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="ap-po-details p-3 radius-xl bg-white d-flex justify-content-between">
        <div>
          <div class="overview-content">
            <h1>
              <%= statistics.active %>
            </h1>
            <p>Active Employees</p>
          </div>
        </div>
        <div class="ap-po-timeChart">
          <div class="overview-single__chart d-md-flex align-items-end">
            <div class="color-success">
              <i class="las la-user-check fs-40"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="ap-po-details p-3 radius-xl bg-white d-flex justify-content-between">
        <div>
          <div class="overview-content">
            <h1>
              <%= statistics.resigned %>
            </h1>
            <p>Resigned</p>
          </div>
        </div>
        <div class="ap-po-timeChart">
          <div class="overview-single__chart d-md-flex align-items-end">
            <div class="color-danger">
              <i class="las la-user-times fs-40"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
      <div class="ap-po-details p-3 radius-xl bg-white d-flex justify-content-between">
        <div>
          <div class="overview-content">
            <h1>
              <%= statistics.mutated %>
            </h1>
            <p>Mutated</p>
          </div>
        </div>
        <div class="ap-po-timeChart">
          <div class="overview-single__chart d-md-flex align-items-end">
            <div class="color-info">
              <i class="las la-exchange-alt fs-40"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="support-ticket-system support-ticket-system--search">
        <div class="breadcrumb-main m-0 breadcrumb-main--table justify-content-sm-between">
          <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
            <div class="d-flex align-items-center ticket__title justify-content-center me-md-25 mb-md-0 mb-20">
              <h5 class="card-title mb-0">All Employees</h5>
            </div>
          </div>
          <div class="action-btn d-flex gap-2">
            <a href="<%= locals.base %>hrd/employees/dashboard/<%- locale %>" class="btn btn-sm btn-info me-2">
              <i class="las la-chart-pie"></i> Dashboard
            </a>
            <% if (locals.userPermissions && userPermissions.employees && userPermissions.employees.includes('create'))
              { %>
              <a href="<%= locals.base %>hrd/employees/create/<%- locale %>" class="btn btn-sm btn-primary">
                <i class="las la-plus"></i> Add New Employee
              </a>
              <% } %>
          </div>
        </div>

        <!-- Search and Filters -->
        <div class="support-form datatable-support-form d-flex justify-content-between align-items-center flex-wrap">
          <div class="support-form__search d-flex">
            <div class="support-order-search me-3">
              <form action="<%= locals.base %>hrd/employees/index/<%- locale %>" method="GET"
                class="support-order-search__form">
                <img src="<%- locals.base %>img/svg/search.svg" alt="search" class="svg" />
                <input class="form-control border-0 box-shadow-none" type="search" name="search" value="<%= search %>"
                  placeholder="Search employees..." aria-label="Search" />
              </form>
            </div>

            <% if (branches && branches.length> 0) { %>
              <select class="form-select me-2" name="branch" onchange="filterByBranch(this)" style="width: auto;">
                <option value="">All Branches</option>
                <% branches.forEach(branch=> { %>
                  <option value="<%= branch._id %>" <%=selectedBranch===branch._id.toString() ? 'selected' : '' %>><%=
                      branch.name %>
                  </option>
                  <% }) %>
              </select>
              <% } %>

                <select class="form-select me-2" name="position" onchange="filterByPosition(this)" style="width: auto;">
                  <option value="">All Positions</option>
                  <% positions.forEach(position=> { %>
                    <option value="<%= position._id %>" <%=selectedPosition===position._id.toString() ? 'selected' : ''
                      %>><%= position.name %>
                    </option>
                    <% }) %>
                </select>

                <select class="form-select" name="status" onchange="filterByStatus(this)" style="width: auto;">
                  <option value="">All Status</option>
                  <option value="Active" <%=selectedStatus==='Active' ? 'selected' : '' %>>Active</option>
                  <option value="Inactive" <%=selectedStatus==='Inactive' ? 'selected' : '' %>>Inactive</option>
                  <option value="Resigned" <%=selectedStatus==='Resigned' ? 'selected' : '' %>>Resigned</option>
                  <option value="Mutated" <%=selectedStatus==='Mutated' ? 'selected' : '' %>>Mutated</option>
                  <option value="Terminated" <%=selectedStatus==='Terminated' ? 'selected' : '' %>>Terminated</option>
                </select>
          </div>
        </div>

        <!-- Employees Table -->
        <div class="userDatatable userDatatable--ticket userDatatable--ticket--2">
          <div class="table-responsive">
            <table class="table mb-0 table-hover">
              <thead>
                <tr class="userDatatable-header">
                  <th>Name</th>
                  <th>Employee Code</th>
                  <th>Position</th>
                  <th>Division</th>
                  <th>Branch</th>
                  <th>Contact</th>
                  <th>Join Date</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (employees && employees.length> 0) { %>
                  <% employees.forEach(employee=> { %>
                    <tr>
                      <td>
                        <div class="contact-personal-info d-flex gap-10">
                          <% if (employee.displayPhotoPath) { %>
                            <img src="<%= locals.base %><%= employee.displayPhotoPath %>"
                              class="rounded-circle wh-34 me-2" alt="profile"
                              style="width: 40px; height: 40px; object-fit: cover;">
                            <% } else { %>
                              <div
                                class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center me-2"
                                style="width: 40px; height: 40px;">
                                <span class="text-white fw-bold">
                                  <%= employee.firstname.charAt(0) %>
                                </span>
                              </div>
                              <% } %>
                                <div>
                                  <span class="fw-500 fw-bold">
                                    <%= employee.firstname %>
                                      <%= employee.lastname || '' %>
                                  </span>
                                  <br>
                                  <small class="text-muted">@<%= employee.username %></small>
                                </div>
                        </div>
                      </td>
                      <td><code><%= employee.employeeCode %></code></td>
                      <td>
                        <%= employee.positionId?.name || '-' %>
                      </td>
                      <td>
                        <%= employee.divisionId?.name || '-' %>
                      </td>
                      <td>
                        <%= employee.branchId?.name || 'Pusat' %>
                      </td>
                      <td>
                        <small>
                          <i class="las la-phone"></i>
                          <%= employee.contact?.noPhone || '-' %>
                        </small>
                      </td>
                      <td>
                        <%= new Date(employee.joinDate).toLocaleDateString() %>
                      </td>
                      <td>
                        <% if (employee.status==='Active' ) { %>
                          <span class="badge bg-opacity-success color-success rounded-pill">Active</span>
                          <% } else if (employee.status==='Inactive' ) { %>
                            <span class="badge bg-opacity-warning color-warning rounded-pill">Inactive</span>
                            <% } else if (employee.status==='Resigned' ) { %>
                              <span class="badge bg-opacity-danger color-danger rounded-pill">Resigned</span>
                              <% } else if (employee.status==='Mutated' ) { %>
                                <span class="badge bg-opacity-info color-info rounded-pill">Mutated</span>
                                <% } else if (employee.status==='Terminated' ) { %>
                                  <span class="badge bg-opacity-dark color-dark rounded-pill">Terminated</span>
                                  <% } %>
                      </td>
                      <td>
                        <ul class="orderDatatable_actions mb-0 d-flex flex-wrap">
                          <li>
                            <a href="<%= locals.base %>hrd/employees/detail/<%= employee._id %>/<%- locale %>"
                              class="view" data-bs-toggle="tooltip" title="View Details">
                              <i class="uil uil-eye"></i>
                            </a>
                          </li>
                          <% if (locals.userPermissions && userPermissions.employees &&
                            userPermissions.employees.includes('update')) { %>
                            <li>
                              <a href="<%= locals.base %>hrd/employees/edit/<%= employee._id %>/<%- locale %>"
                                class="edit" data-bs-toggle="tooltip" title="Edit">
                                <i class="uil uil-edit"></i>
                              </a>
                            </li>
                            <% if (locals.userPermissions && userPermissions.employees &&
                              userPermissions.employees.includes('delete')) { %>
                              <li>
                                <a href="#" class="remove" data-bs-toggle="modal" data-bs-target="#modal-delete"
                                  data-id="<%= employee._id %>"
                                  data-name="<%= employee.firstname %> <%= employee.lastname || '' %>"
                                  title="Delete">
                                  <i class="uil uil-trash"></i>
                                </a>
                              </li>
                            <% } %>
                            <% if (employee.status==='Active' ) { %>
                              <li>
                                <a href="#" class="edit" data-bs-toggle="modal" data-bs-target="#modal-mutate"
                                  data-id="<%= employee._id %>"
                                  data-name="<%= employee.firstname %> <%= employee.lastname || '' %>" title="Mutate">
                                  <i class="uil uil-exchange"></i>
                                </a>
                              </li>
                              <li>
                                <a href="#" class="remove" data-bs-toggle="modal" data-bs-target="#modal-resign"
                                  data-id="<%= employee._id %>"
                                  data-name="<%= employee.firstname %> <%= employee.lastname || '' %>"
                                  title="Process Resignation">
                                  <i class="uil uil-user-times"></i>
                                </a>
                              </li>
                              <% } %>
                                <% } %>
                        </ul>
                      </td>
                    </tr>
                    <% }) %>
                      <% } else { %>
                        <tr>
                          <td colspan="9" class="text-center">No employees found</td>
                        </tr>
                        <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <div class="d-flex justify-content-between align-items-center pt-30">
            <div class="pagination-info">
              Showing <%= ((currentPage - 1) * limit) + 1 %> to <%= Math.min(currentPage * limit, total || 0) %> of <%=
                    total || 0 %> employees
            </div>
            <nav class="dm-page">
              <ul class="dm-pagination d-flex">
                <li class="dm-pagination__item">
                  <% if (totalPages> 1) { %>
                    <% if (currentPage> 1) { %>
                      <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedBranch ? '&branch=' + selectedBranch : '' %><%= selectedPosition ? '&position=' + selectedPosition : '' %><%= selectedStatus ? '&status=' + selectedStatus : '' %>"
                        class="dm-pagination__link pagination-control">
                        <span class="la la-angle-left"></span>
                      </a>
                      <% } %>

                        <% // Calculate page range let startPage=Math.max(1, currentPage - 2); let
                          endPage=Math.min(totalPages, currentPage + 2); if (currentPage <=3) { endPage=Math.min(5,
                          totalPages); } if (currentPage>= totalPages - 2) {
                          startPage = Math.max(1, totalPages - 4);
                          }
                          %>

                          <% if (startPage> 1) { %>
                            <a href="?page=1&limit=<%= limit %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedBranch ? '&branch=' + selectedBranch : '' %><%= selectedPosition ? '&position=' + selectedPosition : '' %><%= selectedStatus ? '&status=' + selectedStatus : '' %>"
                              class="dm-pagination__link">1</a>
                            <% if (startPage> 2) { %>
                              <span class="dm-pagination__dots">...</span>
                              <% } %>
                                <% } %>

                                  <% for (let i=startPage; i <=endPage; i++) { %>
                                    <a href="?page=<%= i %>&limit=<%= limit %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedBranch ? '&branch=' + selectedBranch : '' %><%= selectedPosition ? '&position=' + selectedPosition : '' %><%= selectedStatus ? '&status=' + selectedStatus : '' %>"
                                      class="dm-pagination__link <%= currentPage === i ? 'active' : '' %>">
                                      <span class="page-number">
                                        <%= i %>
                                      </span>
                                    </a>
                                    <% } %>

                                      <% if (endPage < totalPages) { %>
                                        <% if (endPage < totalPages - 1) { %>
                                          <span class="dm-pagination__dots">...</span>
                                          <% } %>
                                            <a href="?page=<%= totalPages %>&limit=<%= limit %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedBranch ? '&branch=' + selectedBranch : '' %><%= selectedPosition ? '&position=' + selectedPosition : '' %><%= selectedStatus ? '&status=' + selectedStatus : '' %>"
                                              class="dm-pagination__link">
                                              <%= totalPages %>
                                            </a>
                                            <% } %>

                                              <% if (currentPage < totalPages) { %>
                                                <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedBranch ? '&branch=' + selectedBranch : '' %><%= selectedPosition ? '&position=' + selectedPosition : '' %><%= selectedStatus ? '&status=' + selectedStatus : '' %>"
                                                  class="dm-pagination__link pagination-control">
                                                  <span class="la la-angle-right"></span>
                                                </a>
                                                <% } %>
                                                  <% } %>
                </li>
                <li class="dm-pagination__item">
                  <div class="paging-option">
                    <select name="page-number" class="page-selection" onchange="changeLimit(this)">
                      <option value="10" <%=limit==10 ? 'selected' : '' %>>10/page</option>
                      <option value="20" <%=limit==20 ? 'selected' : '' %>>20/page</option>
                      <option value="50" <%=limit==50 ? 'selected' : '' %>>50/page</option>
                    </select>
                  </div>
                </li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="modal-delete" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content">
      <form id="deleteForm" method="POST" class="d-inline">
        <div class="modal-header">
          <h6 class="modal-title">Delete Employee</h6>
          <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
            <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg">
          </button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to delete employee: <strong id="delete-employee-name"></strong>?</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Mutate Modal -->
<div class="modal fade" id="modal-mutate" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content">
      <form id="mutateForm" method="POST">
        <div class="modal-header">
          <h6 class="modal-title">Mutate Employee</h6>
          <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
            <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg">
          </button>
        </div>
        <div class="modal-body">
          <p>Mutate employee: <strong id="mutate-employee-name"></strong></p>

          <div class="mb-3">
            <label for="mutate-branch" class="form-label">New Branch <span class="text-danger">*</span></label>
            <select class="form-control" id="mutate-branch" name="branchId" required>
              <option value="">Select Branch</option>
              <% if (branches && branches.length> 0) { %>
                <% branches.forEach(branch=> { %>
                  <option value="<%= branch._id %>" data-name="<%= branch.name %>">
                    <%= branch.name %>
                  </option>
                  <% }) %>
                    <% } %>
            </select>
          </div>

          <div class="mb-3">
            <label for="mutate-position" class="form-label">New Position</label>
            <select class="form-control" id="mutate-position" name="positionId">
              <option value="">Keep Current Position</option>
              <% if (positions && positions.length> 0) { %>
                <% positions.forEach(position=> { %>
                  <option value="<%= position._id %>">
                    <%= position.name %>
                  </option>
                  <% }) %>
                    <% } %>
            </select>
          </div>

          <div class="mb-3">
            <label for="mutate-division" class="form-label">New Division</label>
            <select class="form-control" id="mutate-division" name="divisionId">
              <option value="">Keep Current Division</option>
              <% if (locals.divisions && divisions.length> 0) { %>
                <% divisions.forEach(division=> { %>
                  <option value="<%= division._id %>">
                    <%= division.name %>
                  </option>
                  <% }) %>
                    <% } %>
            </select>
          </div>

          <div class="mb-3">
            <label for="mutate-reason" class="form-label">Reason <span class="text-danger">*</span></label>
            <textarea class="form-control" id="mutate-reason" name="reason" rows="3" required
              placeholder="Please provide reason for mutation"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">
            <i class="las la-exchange-alt"></i> Process Mutation
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Resign Modal -->
<div class="modal fade" id="modal-resign" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content">
      <form id="resignForm" method="POST">
        <div class="modal-header">
          <h6 class="modal-title">Process Resignation</h6>
          <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
            <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg">
          </button>
        </div>
        <div class="modal-body">
          <p>Process resignation for: <strong id="resign-employee-name"></strong></p>

          <div class="alert alert-warning">
            <i class="las la-exclamation-triangle"></i>
            <strong>Warning:</strong> This action will:
            <ul class="mb-0 mt-2">
              <li>Mark the employee as resigned</li>
              <li>Deactivate the employee's user account</li>
              <li>Prevent login to the system</li>
            </ul>
          </div>

          <div class="mb-3">
            <label for="resign-date" class="form-label">Resignation Date <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="resign-date" name="resignDate" required
              value="<%= new Date().toISOString().split('T')[0] %>">
          </div>

          <div class="mb-3">
            <label for="resign-reason" class="form-label">Reason <span class="text-danger">*</span></label>
            <textarea class="form-control" id="resign-reason" name="reason" rows="3" required
              placeholder="Please provide reason for resignation"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger btn-sm">
            <i class="las la-user-times"></i> Process Resignation
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// Handle Delete
document.querySelectorAll('.remove').forEach(btn => {
  btn.addEventListener('click', function () {
    const id = this.getAttribute('data-id');
    const name = this.getAttribute('data-name');
    document.getElementById('delete-employee-name').textContent = name;
    document.getElementById('deleteForm').action = "<%= locals.base %>hrd/employees/delete/" + id + "/<%- locale %>";
    document.getElementById('deleteForm').method = "POST";
    document.getElementById('modal-delete').modal('show');
  });
});

  // Filter functions
  function filterByBranch(select) {
    const params = new URLSearchParams(window.location.search);
    if (select.value) {
      params.set('branch', select.value);
    } else {
      params.delete('branch');
    }
    params.set('page', 1);
    window.location.href = `${window.location.pathname}?${params.toString()}`;
  }

  function filterByPosition(select) {
    const params = new URLSearchParams(window.location.search);
    if (select.value) {
      params.set('position', select.value);
    } else {
      params.delete('position');
    }
    params.set('page', 1);
    window.location.href = `${window.location.pathname}?${params.toString()}`;
  }

  function filterByStatus(select) {
    const params = new URLSearchParams(window.location.search);
    if (select.value) {
      params.set('status', select.value);
    } else {
      params.delete('status');
    }
    params.set('page', 1);
    window.location.href = `${window.location.pathname}?${params.toString()}`;
  }

  function changeLimit(select) {
    const params = new URLSearchParams(window.location.search);
    params.set('limit', select.value);
    params.set('page', 1);
    window.location.href = `${window.location.pathname}?${params.toString()}`;
  }

  // Initialize tooltips
  document.addEventListener('DOMContentLoaded', function () {
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
      return new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Mutate modal handler
    const mutateModal = document.getElementById('modal-mutate');
    if (mutateModal) {
      mutateModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const id = button.getAttribute('data-id');
        const name = button.getAttribute('data-name');

        document.getElementById('mutate-employee-name').textContent = name;
        document.getElementById('mutateForm').action = `<%= locals.base %>hrd/employees/mutate/${id}/<%- locale %>`;

        // Add branch name to form data
        const branchSelect = document.getElementById('mutate-branch');
        branchSelect.addEventListener('change', function () {
          const selectedOption = this.options[this.selectedIndex];
          const branchName = selectedOption.dataset.name;

          // Remove existing hidden input if any
          const existingInput = document.querySelector('input[name="branchName"]');
          if (existingInput) {
            existingInput.remove();
          }

          // Add new hidden input
          if (branchName) {
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'branchName';
            hiddenInput.value = branchName;
            this.form.appendChild(hiddenInput);
          }
        });
      });
    }

    // Resign modal handler
    const resignModal = document.getElementById('modal-resign');
    if (resignModal) {
      resignModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const id = button.getAttribute('data-id');
        const name = button.getAttribute('data-name');

        document.getElementById('resign-employee-name').textContent = name;
        document.getElementById('resignForm').action = `<%= locals.base %>hrd/employees/resign/${id}/<%- locale %>`;
      });
    }

    // Handle form submissions with AJAX
    const mutateForm = document.getElementById('mutateForm');
    if (mutateForm) {
      mutateForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="las la-spinner la-spin"></i> Processing...';
        submitBtn.disabled = true;

        try {
          const response = await fetch(this.action, {
            method: 'POST',
            body: new FormData(this),
          });

          const data = await response.json();

          if (data.success) {
            // Show success message
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-success alert-dismissible fade show';
            alertDiv.innerHTML = `
              ${data.message}
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.querySelector('.container-fluid').insertBefore(alertDiv, document.querySelector('.row'));

            // Close modal and reload page after delay
            bootstrap.Modal.getInstance(document.getElementById('modal-resign')).hide();
            setTimeout(() => window.location.reload(), 1500);
          } else {
            alert(data.error || 'Failed to process resignation');
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
          }
        } catch (error) {
          console.error('Error:', error);
          alert('An error occurred while processing the resignation');
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
        }
      });
    }
  });

  // Prevent form submission on enter key in search
  document.querySelector('.support-order-search__form').addEventListener('keypress', function (e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      this.submit();
    }
  });

  // Auto-submit search form on input change with debounce
  let searchTimeout;
  const searchInput = document.querySelector('input[name="search"]');
  if (searchInput) {
    searchInput.addEventListener('input', function () {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        this.form.submit();
      }, 500);
    });
  }

  // Add keyboard shortcuts
  document.addEventListener('keydown', function (e) {
    // Ctrl+N for new employee
    if (e.ctrlKey && e.key === 'n') {
      e.preventDefault();
      const createBtn = document.querySelector('a[href*="create"]');
      if (createBtn) {
        window.location.href = createBtn.href;
      }
    }

    // Ctrl+F for search focus
    if (e.ctrlKey && e.key === 'f') {
      e.preventDefault();
      const searchInput = document.querySelector('input[name="search"]');
      if (searchInput) {
        searchInput.focus();
        searchInput.select();
      }
    }
  });

  // Export functionality (for future implementation)
  function exportEmployees(format) {
    const params = new URLSearchParams(window.location.search);
    params.set('export', format);
    window.location.href = `<%= locals.base %>hrd/employees/export/<%- locale %>?${params.toString()}`;
  }

  // Batch actions (for future implementation)
  function selectAll(checkbox) {
    const checkboxes = document.querySelectorAll('input[name="employee_ids[]"]');
    checkboxes.forEach(cb => cb.checked = checkbox.checked);
  }

  // Print function
  function printEmployeeList() {
    window.print();
  }


  const resignForm = document.getElementById('resignForm');
  if (resignForm) {
    resignForm.addEventListener('submit', async function (e) {
      e.preventDefault();

      if (!confirm('Are you sure you want to process this resignation? This will deactivate the employee\'s user account.')) {
        return;
      }

      const submitBtn = this.querySelector('button[type="submit"]');
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<i class="las la-spinner la-spin"></i> Processing...';
      submitBtn.disabled = true;

      try {
        const response = await fetch(this.action, {
          method: 'POST',
          body: new FormData(this),
        });

        const data = await response.json();

        if (data.success) {
          // Show success message
          const alertDiv = document.createElement('div');
          alertDiv.className = 'alert alert-success alert-dismissible fade show';
          alertDiv.innerHTML = `
              ${data.message}
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
          document.querySelector('.container-fluid').insertBefore(alertDiv, document.querySelector('.row'));

          // Close modal and reload page after delay
          bootstrap.Modal.getInstance(document.getElementById('modal-mutate')).hide();
          setTimeout(() => window.location.reload(), 1500);
        } else {
          alert(data.error || 'Failed to mutate employee');
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
        }
      } catch (error) {
        console.error('Error:', error);
        alert('An error occurred while processing the mutation');
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
      }
    });
  }

</script>

