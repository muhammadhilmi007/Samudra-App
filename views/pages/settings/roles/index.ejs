// Handle level change in edit modal
function handleEditLevelChange(level) {
  const branchSelection = document.getElementById('edit-branch_selection');
  const branchSelect = document.getElementById('edit-branch_id');
  const usersSelect = document.getElementById('edit-users_id');
  
  if (level === 'cabang') {
    // Show branch selection
    branchSelection.style.display = 'block';
    branchSelect.setAttribute('required', 'required');
  } else if (level === 'pusat') {
    // Hide branch selection
    branchSelection.style.display = 'none';
    branchSelect.removeAttribute('required');
    branchSelect.value = '';
  }
  
  // Filter users based on level
  filterEditUsers(level);
}

// Handle user selection in edit modal
function handleEditUserChange(selectElement) {
  const selectedOption = selectElement.options[selectElement.selectedIndex];
  if (selectedOption.value) {
    const userLevel = selectedOption.getAttribute('data-level');
    const userBranch = selectedOption.getAttribute('data-branch');
    
    // Auto-set role level
    document.getElementById('edit-role_level').value = userLevel;
    
    // Trigger level change
    handleEditLevelChange(userLevel);
    
    // If cabang user, auto-set branch
    if (userLevel === 'cabang' && userBranch) {
      setTimeout(() => {
        document.getElementById('edit-branch_id').value = userBranch;
      }, 100);
    }
  }
}

// Filter users in edit modal based on level
function filterEditUsers(level) {
  const usersSelect = document.getElementById('edit-users_id');
  if (!usersSelect) return;
  
  const options = usersSelect.querySelectorAll('option');
  options.forEach(option => {
    if (option.value) {
      const optionLevel = option.getAttribute('data-level');
      if (level === 'pusat' && optionLevel === 'cabang') {
        option.style.display = 'none';
        if (option.selected) usersSelect.value = '';
      } else if (level === 'cabang' && optionLevel === 'pusat') {
        option.style.display = 'none';
        if (option.selected) usersSelect.value = '';
      } else {
        option.style.display = 'block';
      }
    }
  });
}

// Helper function to generate branch options for edit (excluding pusat)
function generateBranchOptionsEdit(roleData) {
  const branches = <%- JSON.stringify(branches.filter(b => b.type !== 'pusat') || []) %>;
  return branches
    .map(b => `<option value="${b._id}" ${roleData.branch_id && roleData.branch_id._id === b._id ? 'selected' : ''}>${b.name}</option>`)
    .join('');
}

// Helper function to generate user options for edit with level data
function generateUserOptionsEdit(roleData, roleLevel) {
  // This would need to be loaded via AJAX or passed from backend
  const users = <%- JSON.stringify(users || []) %>;
  let html = '';
  
  // Pusat users
  const pusatUsers = users.filter(u => u.level === 'Pusat');
  if (pusatUsers.length > 0) {
    html += `<optgroup label="Pusat Users" style="${roleLevel === 'cabang' ? 'display:none;' : ''}">`;
    pusatUsers.forEach(user => {
      const selected = roleData.users_id && roleData.users_id._id === user._id ? 'selected' : '';
      html += `<option value="${user._id}" data-level="pusat" ${selected}>
                ${user.firstname} ${user.lastname} (${user.email})
              </option>`;
    });
    html += '</optgroup>';
  }
  
  // Cabang users
  const cabangUsers = users.filter(u => u.level === 'Cabang');
  if (cabangUsers.length > 0) {
    html += `<optgroup label="Cabang Users" style="${roleLevel === 'pusat' ? 'display:none;' : ''}">`;
    cabangUsers.forEach(user => {
      const selected = roleData.users_id && roleData.users_id._id === user._id ? 'selected' : '';
      html += `<option value="${user._id}" data-level="cabang" data-branch="${user.branch_id}" ${selected}>
                ${user.firstname} ${user.lastname} (${user.email})
              </option>`;
    });
    html += '</optgroup>';
  }
  
  return html;
}

// Validate edit form before submit
document.getElementById('editRoleForm').addEventListener('submit', function(e) {
  const roleLevel = document.getElementById('edit-role_level').value;
  const branchId = document.getElementById('edit-branch_id').value;
  
  if (roleLevel === 'cabang' && !branchId) {
    e.preventDefault();
    alert('Please select a branch for Cabang level role!');
    return false;
  }
  
  // If pusat, ensure branch_id is empty
  if (roleLevel === 'pusat') {
    document.getElementById('edit-branch_id').value = '';
  }
});

// Helper functions for generating options
function generateParentOptions(roleData) {
  const parentRoles = <%-JSON.stringify(parentRoles || [])%>;
  return parentRoles
    .filter(r => r._id !== roleData._id)
    .map(r => `<option value="${r._id}" ${roleData.parent_role_id && roleData.parent_role_id._id === r._id ? 'selected' : ''}>${r.name}</option>`)
    .join('');
}

function generateBranchOptions(roleData) {
  const branches = <%-JSON.stringify(branches || [])%>;
  return branches
    .map(b => `<option value="${b._id}" ${roleData.branch_id && roleData.branch_id._id === b._id ? 'selected' : ''}>${b.name}</option>`)
    .join('');
}

function generateDivisionOptions(roleData) {
  const divisions = <%-JSON.stringify(divisions || [])%>;
  return divisions
    .map(d => `<option value="${d._id}" ${roleData.division_id && roleData.division_id._id === d._id ? 'selected' : ''}>${d.name}</option>`)
    .join('');
}

function generatePositionOptions(roleData) {
  const positions = <%-JSON.stringify(positions || [])%>;
  return positions
    .map(p => `<option value="${p._id}" ${roleData.position_id && roleData.position_id._id === p._id ? 'selected' : ''}>${p.name} (Level ${p.level})</option>`)
    .join('');
}


function generateUserOptions(roleData) {
  // This would need to be loaded via AJAX
  return roleData.users_id ? `<option value="${roleData.users_id._id}" selected>${roleData.users_id.firstname} ${roleData.users_id.lastname}</option>` : '';
}

