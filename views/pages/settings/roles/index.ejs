<div class="container-fluid">
  <div class="row">
    <div class="col-lg-12">
      <!-- Success/Error Messages -->
      <% if (successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= successMessage %>
          <button type="button" class="btn-close text-capitalize" data-bs-dismiss="alert" aria-label="Close">
            <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg rony" aria-hidden="true">
          </button>
        </div>
      <% } %>
      <% if (errorMessage) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= errorMessage %>
          <button type="button" class="btn-close text-capitalize" data-bs-dismiss="alert" aria-label="Close">
            <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg rony" aria-hidden="true">
          </button>
        </div>
      <% } %>
      
      <!-- Breadcrumb -->
      <div class="breadcrumb-main">
        <h4 class="text-capitalize breadcrumb-title"><%- __('Role Management') %></h4>
        <div class="breadcrumb-action justify-content-center flex-wrap">
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <a href="<%= locals.base %>dashboard/analytics/<%- locale %>">
                  <i class="las la-home"></i><%- __('dashboard-menu-title') %>
                </a>
              </li>
              <li class="breadcrumb-item"><a href="#">Settings</a></li>
              <li class="breadcrumb-item active" aria-current="page">Roles</li>
            </ol>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- Role Hierarchy Visualization -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">Role Hierarchy</h5>
          <div class="card-options">
            <button type="button" class="btn btn-sm btn-primary" onclick="toggleHierarchyView()">
              <i class="uil-sitemap"></i> Toggle View
            </button>
          </div>
        </div>
        <div class="card-body" id="hierarchyContainer" style="display: none;">
          <div id="roleHierarchyDiagram" style="width: 100%; height: 400px; border: 1px solid #ddd;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters and Actions -->
  <div class="row">
    <div class="col-12 mb-30">
      <div class="support-ticket-system support-ticket-system--search">
        <div class="breadcrumb-main m-0 breadcrumb-main--table justify-content-sm-between mb-4">
          <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
            <div class="d-flex align-items-center ticket__title justify-content-center me-md-25 mb-md-0 mb-20">
              <h5 class="card-title mb-0">All Roles</h5>
            </div>
          </div>
          <div class="action-btn">
            <% if (userPermissions && userPermissions.roles && userPermissions.roles.includes('create')) { %>
              <div class="btn-group">
                <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">
                  <i class="uil-plus"></i> Create Role
                </button>
                <ul class="dropdown-menu">
                  <li>
                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#modal-tambah-roles">
                      <i class="uil-file-plus"></i> Create New Role
                    </a>
                  </li>
                  <li>
                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#modal-template-roles">
                      <i class="uil-copy"></i> Create from Template
                    </a>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#modal-bulk-assign">
                      <i class="uil-users-alt"></i> Bulk Assign
                    </a>
                  </li>
                </ul>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Advanced Filters -->
        <div class="card mb-3">
          <div class="card-body">
            <form action="<%= locals.base %>settings/roles/index/<%- locale %>" method="GET" id="filterForm">
              <div class="row g-3">
                <div class="col-md-3">
                  <input type="text" class="form-control" name="search" 
                         value="<%= search %>" placeholder="Search roles...">
                </div>
                <div class="col-md-2">
                  <select class="form-control" name="level">
                    <option value="all">All Levels</option>
                    <option value="pusat" <%= filters.level === 'pusat' ? 'selected' : '' %>>Pusat</option>
                    <option value="cabang" <%= filters.level === 'cabang' ? 'selected' : '' %>>Cabang</option>
                  </select>
                </div>
                <div class="col-md-2">
                  <select class="form-control" name="template">
                    <option value="all">All Types</option>
                    <option value="true" <%= filters.template === 'true' ? 'selected' : '' %>>Templates</option>
                    <option value="false" <%= filters.template === 'false' ? 'selected' : '' %>>Regular</option>
                  </select>
                </div>
                <div class="col-md-3">
                  <select class="form-control" name="branch">
                    <option value="all">All Branches</option>
                    <% branches.forEach(branch => { %>
                      <option value="<%= branch._id %>" <%= filters.branch === branch._id.toString() ? 'selected' : '' %>>
                        <%= branch.name %>
                      </option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                  <button type="submit" class="btn btn-primary w-100">
                    <i class="uil-filter"></i> Filter
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- Roles Table -->
        <div class="userDatatable userDatatable--ticket userDatatable--ticket--2">
          <div class="table-responsive">
            <table class="table mb-0 table-hover">
              <thead>
                <tr class="userDatatable-header">
                  <th>Name</th>
                  <th>Type</th>
                  <th>Level</th>
                  <th>Branch</th>
                  <th>Division</th>
                  <th>Position</th>
                  <th>Parent Role</th>
                  <th>Assigned To</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (roles && roles.length > 0) { %>
                  <% roles.forEach(function(role) { %>
                    <tr class="<%= role.isTemplate ? 'table-info' : '' %>">
                      <td>
                        <strong><%= role.name %></strong>
                        <% if (role.description) { %>
                          <br/><small class="text-muted"><%= role.description %></small>
                        <% } %>
                      </td>
                      <td>
                        <% if (role.isTemplate) { %>
                          <span class="bg-info text-white userDatatable-content-status active">Template</span>
                        <% } else { %>
                          <span class="bg-secondary text-white userDatatable-content-status active">Regular</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (role.users_id && role.users_id.level) { %>
                          <span class="bg-opacity-<%= role.users_id.level === 'Pusat' ? 'success' : 'warning' %> color-<%= role.users_id.level === 'Pusat' ? 'success' : 'warning' %> userDatatable-content-status active">
                            <%= role.users_id.level %>
                          </span>
                        <% } else if (!role.branch_id || (role.branch_id && role.branch_id.type === 'pusat')) { %>
                          <span class="bg-opacity-success color-primary userDatatable-content-status active">Pusat</span>
                        <% } else { %>
                          <span class="bg-opacity-warning color-warning userDatatable-content-status active">Cabang</span>
                        <% } %>
                      </td>
                      <td><%= role.branch_id ? role.branch_id.name : 'All Branches' %></td>
                      <td><%= role.division_id ? role.division_id.name : '-' %></td>
                      <td><%= role.position_id ? role.position_id.name : '-' %></td>
                      <td>
                        <% if (role.parent_role_id) { %>
                          <span class="bg-opacity-info color-info userDatatable-content-status active ">
                            <i class="uil-sitemap"></i> <strong><%= role.parent_role_id.name %></strong>
                          </span>
                        <% } else { %>
                          <span class="text-muted">-</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (role.users_id) { %>
                          <small>
                            <%= role.users_id.firstname %> <%= role.users_id.lastname %><br/>
                            <span class="text-muted"><%= role.users_id.email %></span>
                          </small>
                        <% } else { %>
                          <span class="text-muted">Not assigned</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (role.isActive) { %>
                          <span class="bg-opacity-success color-success userDatatable-content-status active">Active</span>
                        <% } else { %>
                          <span class="bg-opacity-danger color-danger userDatatable-content-status active">Inactive</span>
                        <% } %>
                      </td>
                      <td>
                        <ul class="orderDatatable_actions mb-0 d-flex flex-wrap justify-content-center">
                          <% if (userPermissions && userPermissions.roles && userPermissions.roles.includes('update')) { %>
                            <li>
                              <a href="<%= locals.base %>settings/roles/edit/<%= role._id %>/permissions/<%- locale %>" 
                                 class="view" title="Manage Permissions">
                                <i class="uil-shield"></i>
                              </a>
                            </li>
                            <li>
                              <a href="#" class="edit" 
                                 data-id="<%= role._id %>" 
                                 data-role='<%= JSON.stringify(role) %>'
                                 data-bs-toggle="modal" 
                                 data-bs-target="#modal-edit-roles"
                                 title="Edit Role">
                                <i class="uil-pen"></i>
                              </a>
                            </li>
                          <% } %>
                          <% if (userPermissions && userPermissions.roles && userPermissions.roles.includes('delete')) { %>
                            <li>
                              <a class="remove" href="#" 
                                 data-id="<%= role._id %>" 
                                 data-bs-toggle="modal" 
                                 data-bs-target="#modal-delete"
                                 title="Delete Role">
                                <i class="uil-trash"></i>
                              </a>
                            </li>
                          <% } %>
                        </ul>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="10" class="text-center">No roles found</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          
          <!-- Pagination -->
          <div class="d-flex justify-content-between align-items-center pt-30">
            <div class="pagination-info">
              Showing <%= ((currentPage - 1) * limit) + 1 %> to <%= Math.min(currentPage * limit, total || 0) %> of <%=
                    total || 0 %> Roles
            </div>
            <nav class="dm-page">
              <ul class="dm-pagination d-flex">
                <li class="dm-pagination__item">
                  <% if (totalPages > 1) { %>
                    <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>&level=<%= filters.level %>&template=<%= filters.template %>&branch=<%= filters.branch %>&search=<%= search %>"
                       class="dm-pagination__link pagination-control <%= currentPage === 1 ? 'disabled' : '' %>">
                      <span class="la la-angle-left"></span>
                    </a>
                    
                    <% for (let i = 1; i <= totalPages; i++) { %>
                      <a href="?page=<%= i %>&limit=<%= limit %>&level=<%= filters.level %>&template=<%= filters.template %>&branch=<%= filters.branch %>&search=<%= search %>"
                         class="dm-pagination__link <%= currentPage === i ? 'active' : '' %>">
                        <span class="page-number"><%= i %></span>
                      </a>
                    <% } %>
                    
                    <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>&level=<%= filters.level %>&template=<%= filters.template %>&branch=<%= filters.branch %>&search=<%= search %>"
                       class="dm-pagination__link pagination-control <%= currentPage === totalPages ? 'disabled' : '' %>">
                      <span class="la la-angle-right"></span>
                    </a>
                  <% } %>
                </li>
                <li class="dm-pagination__item">
                  <div class="paging-option">
                    <select name="page-number" class="page-selection">
                      <option value="5" <%= limit == 5 ? 'selected' : '' %>>5/page</option>
                      <option value="10" <%= limit == 10 ? 'selected' : '' %>>10/page</option>
                      <option value="20" <%= limit == 20 ? 'selected' : '' %>>20/page</option>
                    </select>
                  </div>
                </li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal for Delete Confirmation -->
<div class="modal-delete modal fade" id="modal-delete" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-info" role="document">
    <div class="modal-content">
      <div class="modal-body">
        <div class="modal-info-body d-flex">
          <div class="modal-info-icon warning">
            <img src="<%- locals.base %>img/svg/alert-circle.svg" alt="alert-circle" class="svg">
          </div>
          <div class="modal-info-text">
            <h6>Do you want to delete this role?</h6>
            <p>This action cannot be undone. Make sure no users are assigned to this role.</p>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-outlined btn-sm" data-bs-dismiss="modal">No</button>
        <form id="modalDeleteForm" method="POST" class="d-inline">
          <button type="submit" class="btn btn-success btn-outlined btn-sm">Yes</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modal for Adding Roles -->
<div class="modal-tambah-roles modal fade show" id="modal-tambah-roles" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content modal-bg-white">
      <form method="POST" action="<%= locals.base %>settings/roles/create/<%- locale %>">
        <div class="modal-header">
          <h6 class="modal-title">Create New Role</h6>
          <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
            <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg">
          </button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6">
              <!-- Role Name -->
              <div class="mb-3">
                <label for="name" class="form-label">Role Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="name" name="name" 
                       placeholder="e.g., Sales Manager - Jakarta" required>
                <div class="form-text">Use descriptive names like "Finance Staff - Bandung"</div>
              </div>
            </div>
            
            <div class="col-md-6">
              <!-- Level Selection -->
              <div class="mb-3">
                <label for="role_level" class="form-label">Role Level <span class="text-danger">*</span></label>
                <select class="form-control" id="role_level" name="role_level" required>
                  <option value="">Select Level</option>
                  <option value="pusat">Pusat (Head Office)</option>
                  <option value="cabang">Cabang (Branch)</option>
                </select>
                <div class="form-text">Choose whether this role is for Pusat or Cabang</div>
              </div>
            </div>
          </div>

          <!-- Branch Selection (Hidden by default) -->
          <div class="row" id="branch_selection" style="display: none;">
            <div class="col-md-12">
              <div class="mb-3">
                <label for="branch_id" class="form-label">Branch <span class="text-danger">*</span></label>
                <select class="form-control" id="branch_id" name="branch_id">
                  <option value="">Select Branch</option>
                  <% branches.filter(b => b.type !== 'pusat').forEach(branch => { %>
                    <option value="<%= branch._id %>">
                      <%= branch.name %>
                    </option>
                  <% }) %>
                </select>
                <div class="form-text">Select the branch for this role</div>
              </div>
            </div>
          </div>

          <!-- Description -->
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control" id="description" name="description" rows="2"
                      placeholder="Brief description of role responsibilities"></textarea>
          </div>

          <div class="row">
            <div class="col-md-6">
              <!-- Division -->
              <div class="mb-3">
                <label for="division_id" class="form-label">Division <span class="text-danger">*</span></label>
                <select class="form-control" id="division_id" name="division_id" required>
                  <option value="">Select Division</option>
                  <% divisions.forEach(division => { %>
                    <option value="<%= division._id %>"><%= division.name %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            
            <div class="col-md-6">
              <!-- Position -->
              <div class="mb-3">
                <label for="position_id" class="form-label">Position <span class="text-danger">*</span></label>
                <select class="form-control" id="position_id" name="position_id" required>
                  <option value="">Select Position</option>
                  <% positions.forEach(position => { %>
                    <option value="<%= position._id %>">
                      <%= position.name %> (Level <%= position.level %>)
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6">
              <!-- Parent Role -->
              <div class="mb-3">
                <label for="parent_role_id" class="form-label">Parent Role</label>
                <select class="form-control" id="parent_role_id" name="parent_role_id">
                  <option value="">No Parent (Top Level)</option>
                  <% if (typeof parentRoles !== 'undefined' && parentRoles) { %>
                    <% parentRoles.forEach(pr => { %>
                      <option value="<%= pr._id %>"><%= pr.name %></option>
                    <% }) %>
                  <% } %>
                </select>
                <div class="form-text">Select parent for permission inheritance</div>
              </div>
            </div>
            
            <div class="col-md-6">
              <!-- User Assignment -->
              <div class="mb-3">
                <label for="users_id" class="form-label">Assign to User</label>
                <select class="form-control" id="users_id" name="users_id">
                  <option value="">Not assigned to specific user</option>
                  <% if (typeof users !== 'undefined' && users) { %>
                    <optgroup label="Pusat Users" id="pusat_users_group">
                      <% users.filter(u => u.level === 'Pusat').forEach(user => { %>
                        <option value="<%= user._id %>" data-level="pusat">
                          <%= user.firstname %> <%= user.lastname %> (<%= user.email %>)
                        </option>
                      <% }) %>
                    </optgroup>
                    <optgroup label="Cabang Users" id="cabang_users_group">
                      <% users.filter(u => u.level === 'Cabang').forEach(user => { %>
                        <option value="<%= user._id %>" data-level="cabang" data-branch="<%= user.branch_id %>">
                          <%= user.firstname %> <%= user.lastname %> (<%= user.email %>)
                        </option>
                      <% }) %>
                    </optgroup>
                  <% } %>
                </select>
              </div>
            </div>
          </div>

          <!-- Options -->
          <div class="row">
            <div class="col-md-6">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="isActive" name="isActive" checked>
                <label class="form-check-label" for="isActive">Active Status</label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="isTemplate" name="isTemplate">
                <label class="form-check-label" for="isTemplate">Save as Template</label>
              </div>
            </div>
          </div>

          <!-- Info Alert -->
          <div class="alert alert-info mt-3">
            <i class="bx bx-info-circle"></i>
            <strong>Note: </strong> 
            <ul class="mb-0">
              <li>Pusat roles have organization-wide permissions</li>
              <li>Cabang roles are limited to their specific branch</li>
              <li>After creating this role, set its permissions by clicking the shield icon</li>
            </ul>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary"><i class="bx uil-save"></i> Create Role</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal for Creating from Template -->
<div class="modal fade" id="modal-template-roles" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content modal-bg-white">
      <form method="POST" action="<%= locals.base %>settings/roles/create-from-template/<%- locale %>">
        <div class="modal-header">
          <h6 class="modal-title">Create Role from Template</h6>
          <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
            <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg">
          </button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="template_id" class="form-label">Select Template <span class="text-danger">*</span></label>
            <select class="form-control" id="template_id" name="template_id" required>
              <option value="">Choose a template...</option>
            </select>
          </div>
          
          <div class="mb-3">
            <label for="template_name" class="form-label">Role Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="template_name" name="name" 
                   placeholder="Enter role name" required>
          </div>
          
          <div class="mb-3">
            <label for="template_role_level" class="form-label">Role Level <span class="text-danger">*</span></label>
            <select class="form-control" id="template_role_level" name="role_level" required>
              <option value="">Select Level</option>
              <option value="pusat">Pusat (Head Office)</option>
              <option value="cabang">Cabang (Branch)</option>
            </select>
          </div>
          
          <div class="mb-3" id="template_branch_selection" style="display: none;">
            <label for="template_branch_id" class="form-label">Branch <span class="text-danger">*</span></label>
            <select class="form-control" id="template_branch_id" name="branch_id">
              <option value="">Select Branch</option>
              <% branches.filter(b => b.type !== 'pusat').forEach(branch => { %>
                <option value="<%= branch._id %>"><%= branch.name %></option>
              <% }) %>
            </select>
          </div>
          
          <div class="mb-3">
            <label for="template_users_id" class="form-label">Assign to User</label>
            <select class="form-control" id="template_users_id" name="users_id">
              <option value="">Not assigned</option>
              <% if (typeof users !== 'undefined' && users) { %>
                <optgroup label="Pusat Users" id="template_pusat_users">
                  <% users.filter(u => u.level === 'Pusat').forEach(user => { %>
                    <option value="<%= user._id %>" data-level="pusat">
                      <%= user.firstname %> <%= user.lastname %> (<%= user.email %>)
                    </option>
                  <% }) %>
                </optgroup>
                <optgroup label="Cabang Users" id="template_cabang_users">
                  <% users.filter(u => u.level === 'Cabang').forEach(user => { %>
                    <option value="<%= user._id %>" data-level="cabang" data-branch="<%= user.branch_id._id %>">
                      <%= user.firstname %> <%= user.lastname %> (<%= user.email %>)
                    </option>
                  <% }) %>
                </optgroup>
              <% } %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">Create from Template</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal for Bulk Assignment -->
<div class="modal fade" id="modal-bulk-assign" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content modal-bg-white">
      <form method="POST" action="<%= locals.base %>settings/roles/bulk-assign/<%- locale %>">
        <div class="modal-header">
          <h6 class="modal-title">Bulk Role Assignment</h6>
          <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
            <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg">
          </button>
        </div>
