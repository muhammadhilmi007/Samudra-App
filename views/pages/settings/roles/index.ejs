<!-- Load ApexTree for hierarchy visualization -->
<script src="https://cdn.jsdelivr.net/npm/apextree"></script>

<script>
// Initialize variables
let hierarchyDiagram = null;
let hierarchyVisible = false;

// Toggle hierarchy view
function toggleHierarchyView() {
  const container = document.getElementById('hierarchyContainer');
  if (hierarchyVisible) {
    container.style.display = 'none';
    hierarchyVisible = false;
  } else {
    container.style.display = 'block';
    hierarchyVisible = true;
    if (!hierarchyDiagram) {
      loadHierarchyDiagram();
    }
  }
}

// Load hierarchy diagram
function loadHierarchyDiagram() {
  fetch('<%= locals.base %>settings/roles/api/hierarchy')
    .then(response => response.json())
    .then(data => {
      if (data.success && data.treeData) {
        initializeApexTree(data.treeData);
      } else {
        console.warn('No hierarchy data available');
        document.getElementById('roleHierarchyDiagram').innerHTML = 
          '<div class="text-center text-muted p-4">No role hierarchy data available</div>';
      }
    })
    .catch(error => {
      console.error('Error loading hierarchy:', error);
      document.getElementById('roleHierarchyDiagram').innerHTML = 
        '<div class="text-center text-danger p-4">Error loading hierarchy data</div>';
    });
}

// Initialize ApexTree diagram
function initializeApexTree(treeData) {
  try {
    // Clear the container first
    const container = document.getElementById('roleHierarchyDiagram');
    container.innerHTML = '';
    
    // ApexTree options
    const options = {
      contentKey: 'data',
      width: 1500,
      nodeWidth: 200,
      nodeHeight: 150,
      fontColor: '#fff',
      borderColor: '#333',
      childrenSpacing: 60,
      siblingSpacing: 30,
      direction: 'top',
      nodeTemplate: (content) =>
        `<div style='display: flex;flex-direction: column;gap: 8px;justify-content: center;align-items: center;height: 100%;padding: 10px;'>
          <img style='width: 40px;height: 40px;border-radius: 50%;border: 2px solid #fff;' src='${content.imageURL}' alt='${content.name}' />
          <div style="font-weight: bold; font-family: Arial; font-size: 13px; text-align: center; line-height: 1.2;">${content.name}</div>
          <div style="font-size: 10px; opacity: 0.9; text-align: center;">${content.position}</div>
          <div style="font-size: 9px; opacity: 0.8; text-align: center;">${content.branch}</div>
          <div style="font-size: 8px; opacity: 0.7; text-align: center;">${content.assignedUser}</div>
        </div>`,
      canvasStyle: 'border: 1px solid #ddd;background: #f8f9fa;border-radius: 8px;',
      enableToolbar: true,
    };
    
    // Create and render the tree
    hierarchyDiagram = new ApexTree(container, options);
    hierarchyDiagram.render(treeData);
    
    console.log('ApexTree hierarchy rendered successfully');
  } catch (error) {
    console.error('Error initializing ApexTree:', error);
    document.getElementById('roleHierarchyDiagram').innerHTML = 
      '<div class="text-center text-danger p-4">Error rendering hierarchy visualization</div>';
  }
}

// Handle delete
document.querySelectorAll('.remove').forEach(btn => {
  btn.addEventListener('click', function() {
    const roleId = this.getAttribute('data-id');
    const form = document.getElementById('modalDeleteForm');
    form.action = "<%= locals.base %>settings/roles/delete/" + roleId + "/<%- locale %>";
    form.method = "POST";
  });
});

// Handle level change for template modal
document.getElementById('template_role_level').addEventListener('change', function() {
  const branchSelection = document.getElementById('template_branch_selection');
  const branchSelect = document.getElementById('template_branch_id');
  const pusatUsers = document.getElementById('template_pusat_users');
  const cabangUsers = document.getElementById('template_cabang_users');
  
  if (this.value === 'cabang') {
    branchSelection.style.display = 'block';
    branchSelect.setAttribute('required', 'required');
    if (pusatUsers) pusatUsers.style.display = 'none';
    if (cabangUsers) cabangUsers.style.display = 'block';
  } else if (this.value === 'pusat') {
    branchSelection.style.display = 'none';
    branchSelect.removeAttribute('required');
    branchSelect.value = '';
    if (pusatUsers) pusatUsers.style.display = 'block';
    if (cabangUsers) cabangUsers.style.display = 'none';
  }
  
  // Reset user selection
  document.getElementById('template_users_id').value = '';
});

// Handle user selection in template modal
document.getElementById('template_users_id').addEventListener('change', function() {
  const selectedOption = this.options[this.selectedIndex];
  if (selectedOption.value) {
    const userLevel = selectedOption.getAttribute('data-level');
    const userBranch = selectedOption.getAttribute('data-branch');
    
    // Auto-set role level
    document.getElementById('template_role_level').value = userLevel;
    
    // Trigger level change event
    document.getElementById('template_role_level').dispatchEvent(new Event('change'));
    
    // If cabang user, auto-set branch
    if (userLevel === 'cabang' && userBranch) {
      setTimeout(() => {
        document.getElementById('template_branch_id').value = userBranch;
      }, 100);
    }
  }
});

// Validate template form before submit
document.querySelector('#modal-template-roles form').addEventListener('submit', function(e) {
  const roleLevel = document.getElementById('template_role_level').value;
  const branchId = document.getElementById('template_branch_id').value;
  
  if (roleLevel === 'cabang' && !branchId) {
    e.preventDefault();
    alert('Please select a branch for Cabang level role!');
    return false;
  }
});

// Handle level change for create modal
document.getElementById('role_level').addEventListener('change', function() {
  const branchSelection = document.getElementById('branch_selection');
  const branchSelect = document.getElementById('branch_id');
  const usersSelect = document.getElementById('users_id');
  const pusatUsersGroup = document.getElementById('pusat_users_group');
  const cabangUsersGroup = document.getElementById('cabang_users_group');
  
  if (this.value === 'cabang') {
    // Show branch selection
    branchSelection.style.display = 'block';
    branchSelect.setAttribute('required', 'required');
    
    // Hide pusat users, show cabang users
    if (pusatUsersGroup) pusatUsersGroup.style.display = 'none';
    if (cabangUsersGroup) cabangUsersGroup.style.display = 'block';
    
    // Reset user selection
    usersSelect.value = '';
  } else if (this.value === 'pusat') {
    // Hide branch selection
    branchSelection.style.display = 'none';
    branchSelect.removeAttribute('required');
    branchSelect.value = '';
    
    // Show pusat users, hide cabang users
    if (pusatUsersGroup) pusatUsersGroup.style.display = 'block';
    if (cabangUsersGroup) cabangUsersGroup.style.display = 'none';
    
    // Reset user selection
    usersSelect.value = '';
  }
});

// Handle edit with level rules
document.querySelectorAll('.edit').forEach(btn => {
  btn.addEventListener('click', function() {
    const roleData = JSON.parse(this.dataset.role);
    const form = document.getElementById('editRoleForm');
    form.action = "<%= locals.base %>settings/roles/update/" + roleData._id + "/<%- locale %>";
    
    // Determine role level
    let roleLevel = 'cabang';
    if (!roleData.branch_id || (roleData.branch_id && roleData.branch_id.type === 'pusat')) {
      roleLevel = 'pusat';
    }
    
    // Populate modal content with level handling
    const modalBody = form.querySelector('.modal-body');
    modalBody.innerHTML = `
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <label for="edit-name" class="form-label">Role Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="edit-name" name="name" value="${roleData.name}" required>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <label for="edit-role_level" class="form-label">Role Level <span class="text-danger">*</span></label>
            <select class="form-control" id="edit-role_level" name="role_level" required>
              <option value="pusat" ${roleLevel === 'pusat' ? 'selected' : ''}>Pusat (Head Office)</option>
              <option value="cabang" ${roleLevel === 'cabang' ? 'selected' : ''}>Cabang (Branch)</option>
            </select>
          </div>
        </div>
      </div>
      
      <!-- Branch Selection (conditionally shown) -->
      <div class="row" id="edit-branch_selection" style="${roleLevel === 'cabang' ? 'display: block;' : 'display: none;'}">
        <div class="col-md-12">
          <div class="mb-3">
            <label for="edit-branch_id" class="form-label">Branch <span class="text-danger">*</span></label>
            <select class="form-control" id="edit-branch_id" name="branch_id" ${roleLevel === 'cabang' ? 'required' : ''}>
              <option value="">Select Branch</option>
              ${generateBranchOptionsEdit(roleData)}
            </select>
          </div>
        </div>
      </div>
      
      <div class="mb-3">
        <label for="edit-description" class="form-label">Description</label>
        <textarea class="form-control" id="edit-description" name="description" rows="2">${roleData.description || ''}</textarea>
      </div>
      
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <label for="edit-division_id" class="form-label">Division <span class="text-danger">*</span></label>
            <select class="form-control" id="edit-division_id" name="division_id" required>
              ${generateDivisionOptions(roleData)}
            </select>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <label for="edit-position_id" class="form-label">Position <span class="text-danger">*</span></label>
            <select class="form-control" id="edit-position_id" name="position_id" required>
              ${generatePositionOptions(roleData)}
            </select>
          </div>
        </div>
      </div>
      
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <label for="edit-parent_role_id" class="form-label">Parent Role</label>
            <select class="form-control" id="edit-parent_role_id" name="parent_role_id">
              <option value="">No Parent</option>
              ${generateParentOptions(roleData)}
            </select>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <label for="edit-users_id" class="form-label">Assigned User</label>
            <select class="form-control" id="edit-users_id" name="users_id">
              <option value="">Not assigned</option>
              ${generateUserOptionsEdit(roleData, roleLevel)}
            </select>
          </div>
        </div>
      </div>
      
      <div class="row">
        <div class="col-md-6">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="edit-isActive" name="isActive" ${roleData.isActive ? 'checked' : ''}>
            <label class="form-check-label" for="edit-isActive">Active Status</label>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="edit-isTemplate" name="isTemplate" ${roleData.isTemplate ? 'checked' : ''}>
            <label class="form-check-label" for="edit-isTemplate">Is Template</label>
          </div>
        </div>
      </div>
    `;
    
    // Add event listener for level change in edit modal
    setTimeout(() => {
      const editLevelSelect = document.getElementById('edit-role_level');
      if (editLevelSelect) {
        editLevelSelect.addEventListener('change', function() {
          handleEditLevelChange(this.value);
        });
      }
      
      // Add event listener for user selection in edit modal
      const editUserSelect = document.getElementById('edit-users_id');
      if (editUserSelect) {
        editUserSelect.addEventListener('change', function() {
          handleEditUserChange(this);
        });
      }
