<div class="container-fluid">
  <div class="row">
    <div class="col-lg-12">
      <!-- Success/Error Messages -->
      <% if (successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= successMessage %>
            <button type="button" class="btn-close text-capitalize" data-bs-dismiss="alert" aria-label="Close">
              <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg rony" aria-hidden="true">
            </button>
        </div>
        <% } %>
          <% if (errorMessage) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <%= errorMessage %>
                <button type="button" class="btn-close text-capitalize" data-bs-dismiss="alert" aria-label="Close">
                  <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg rony" aria-hidden="true">
                </button>
            </div>
            <% } %>
              <div class="breadcrumb-main">
                <h4 class="text-capitalize breadcrumb-title">
                  <%- __('User Management') %>
                </h4>
                <div class="breadcrumb-action justify-content-center flex-wrap">
                  <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                      <li class="breadcrumb-item">
                        <a href="<%= locals.base %>dashboard/analytics/<%- locale %>"><i class="las la-home"></i><%-
                            __('dashboard-menu-title') %></a>
                      </li>
                      <li class="breadcrumb-item"><a href="#">Settings</a></li>
                      <li class="breadcrumb-item active" aria-current="page">
                        <%- __('Users') %>
                      </li>
                    </ol>
                  </nav>
                </div>
              </div>
    </div>
  </div>
  <div class="row">
    <div class="col-md-30">
      <div class="support-ticket-system support-ticket-system--search">
        <div class="breadcrumb-main m-0 breadcrumb-main--table justify-content-sm-between">
          <div class="d-flex flex-wrap justify-content-center breadcrumb-main__wrapper">
            <div class="d-flex align-items-center ticket__title justify-content-center me-md-25 mb-md-0 mb-20">
              <h5 class="card-title mb-0">All Users</h4>
            </div>
          </div>
          <div class="action-btn mt-sm-0 mt-15 gap-2 d-flex">
            <a href="#" class="btn px-20 btn-success" data-bs-toggle="modal" data-bs-target="#modal-export">
              <i class="las la-file-export fs-16"></i>Export
            </a>
            <% if (userPermissions && userPermissions.users && userPermissions.users.includes('create')) { %>
              <a href="#" class="btn px-20 btn-primary" data-bs-toggle="modal" data-bs-target="#modal-tambah-users">
                <i class="las la-plus fs-16"></i>Add New User
              </a>
              <% } %>
          </div>
        </div>

        <!-- Search & Filter Division -->
        <div
          class="support-form datatable-support-form d-flex justify-content-xxl-between justify-content-center align-items-center flex-wrap">
          <div class="support-form__search">
            <div class="support-order-search">
              <form action="<%= locals.base %>settings/users/index/<%- locale %>" method="GET"
                class="support-order-search__form">
                <img src="<%- locals.base %>img/svg/search.svg" alt="search" class="svg" />
                <input class="form-control border-0 box-shadow-none" type="search" name="search"
                  value="<%= typeof search !== 'undefined' ? search : '' %>"
                  placeholder="Search by name, username, or email" aria-label="Search" />
              </form>
            </div>
          </div>

          <!-- Filters -->
          <div class="support-form__filter">
            <div class="d-flex align-items-center flex-wrap gap-2">
              <select class="form-select form-select-sm" id="filterLevel" style="width: auto;">
                <option value="">All Levels</option>
                <option value="Pusat" <%=filters && filters.level==='Pusat' ? 'selected' : '' %>>Pusat</option>
                <option value="Cabang" <%=filters && filters.level==='Cabang' ? 'selected' : '' %>>Cabang</option>
              </select>

              <select class="form-select form-select-sm" id="filterBranch" style="width: auto;">
                <option value="">All Branches</option>
                <% branches.forEach(branch=> { %>
                  <option value="<%= branch._id %>" <%=filters && filters.branch===branch._id.toString() ? 'selected'
                    : '' %>><%= branch.name %>
                  </option>
                  <% }) %>
              </select>

              <select class="form-select form-select-sm" id="filterStatus" style="width: auto;">
                <option value="">All Status</option>
                <option value="true" <%=filters && filters.isActive==='true' ? 'selected' : '' %>>Active</option>
                <option value="false" <%=filters && filters.isActive==='false' ? 'selected' : '' %>>Inactive</option>
              </select>

              <button class="btn btn-sm btn-primary" style="width: auto;" id="resetFilters">
                <i class="las la-undo"></i> Reset
              </button>
            </div>
          </div>
        </div>

        <!-- Users Table -->
        <div class="userDatatable userDatatable--ticket userDatatable--ticket--2">
          <div class="table-responsive">
            <table class="table mb-0 table-hover">
              <thead>
                <tr class="userDatatable-header">
                  <th>Username</th>
                  <th>Email</th>
                  <th>Level</th>
                  <th>Branch</th>
                  <th>Division</th>
                  <th>Position</th>
                  <th>Role</th>
                  <th>Status</th>
                  <th>Last Login</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (users && users.length> 0) { %>
                  <% users.forEach(user=> { %>
                    <tr>
                      <td>
                        <div class="contact-personal-info d-flex gap-10">
                          <% if (user.photoProfile) { %>
                            <img src="<%= locals.base %><%= user.photoProfile %>" alt="<%= user.fullName %>"
                              class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;">
                            <% } else { %>
                              <div
                                class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center me-2"
                                style="width: 40px; height: 40px;">
                                <span class="text-white fw-bold">
                                  <%= user.firstname.charAt(0).toUpperCase() %>
                                </span>
                              </div>
                              <% } %>
                                <div>
                                  <strong>
                                    <%= user.fullName %>
                                  </strong>
                                  <% if (session && session.user && user.email===session.user.email) { %>
                                    <span class="badge bg-info ms-1">You</span>
                                    <% } %>
                                      <br>
                                      <small class="text-muted">@<%= user.username %></small>
                                </div>
                        </div>
                      </td>
                      <td>
                        <%= user.email %>
                      </td>
                      <td>
                        <span
                          class="bg-opacity-<%= user.level === 'Pusat' ? 'success' : 'info' %> color-<%= user.level === 'Pusat' ? 'success' : 'info' %> userDatatable-content-status active">
                          <%= user.level %>
                        </span>
                      </td>
                      <td>
                        <%= user.branch_id ? user.branch_id.name : '-' %>
                      </td>
                      <td>
                        <%= user.division_id ? user.division_id.name : '-' %>
                      </td>
                      <td>
                        <%= user.position_id ? user.position_id.name : '-' %>
                      </td>
                      <td>
                        <% if (user.role_id) { %>
                          <div class="userDatatable-content d-inline-block">
                            <span class="bg-info color-white userDatatable-content-status active">
                              <%= user.role_id.name %>
                            </span>
                          </div>
                          <% } else { %>
                            <span class="text-muted">No role</span>
                            <% } %>
                      </td>
                      <td>
                        <% if (user.isActive) { %>
                          <div class="userDatatable-content d-inline-block">
                            <span
                              class="bg-opacity-success color-success userDatatable-content-status active">Active</span>
                          </div>
                          <% } else { %>
                            <div class="userDatatable-content d-inline-block">
                              <span
                                class="bg-opacity-danger color-danger userDatatable-content-status active">Inactive</span>
                            </div>
                            <% } %>
                      </td>
                      <td>
                        <% if (user.lastLogin) { %>
                          <%= new Date(user.lastLogin).toLocaleDateString() %>
                            <br />
                            <small class="text-muted">
                              <%= new Date(user.lastLogin).toLocaleTimeString() %>
                            </small>
                            <% } else { %>
                              <div class="userDatatable-content d-inline-block">
                                <span
                                  class="bg-opacity-warning color-warning userDatatable-content-status active">Never</span>
                              </div>
                              <% } %>
                      </td>
                      <td>
                        <ul class="orderDatatable_actions mb-0 d-flex flex-wrap justify-content-center">
                          <% if (userPermissions && userPermissions.users && userPermissions.users.includes('read')) {
                            %>
                            <li>
                              <a href="<%= locals.base %>settings/users/detail/<%= user._id %>/<%- locale %>"
                                class="view" data-bs-toggle="tooltip" title="View Details">
                                <i class="uil-eye"></i>
                              </a>
                            </li>
                            <% } %>
                              <% if (userPermissions && userPermissions.users &&
                                userPermissions.users.includes('update')) { %>
                                <li>
                                  <a href="#" class="edit" title="Edit User" data-bs-toggle="modal"
                                    data-bs-target="#modal-edit-users" data-id="<%= user._id %>"
                                    data-username="<%= user.username || '' %>"
                                    data-firstname="<%= user.firstname || '' %>"
                                    data-lastname="<%= user.lastname || '' %>" data-email="<%= user.email || '' %>"
                                    data-phonenumber="<%= user.phoneNumber || '' %>"
                                    data-photo="<%= user.photoProfile || '' %>"
                                    data-level="<%= user.level || 'Cabang' %>"
                                    data-branch="<%= user.branch_id ? user.branch_id._id : '' %>"
                                    data-division="<%= user.division_id ? user.division_id._id : '' %>"
                                    data-position="<%= user.position_id ? user.position_id._id : '' %>"
                                    data-active="<%= user.isActive %>">
                                    <i class="uil uil-edit"></i>
                                  </a>
                                </li>
                                <% } %>
                                  <% if (userPermissions && userPermissions.users &&
                                    userPermissions.users.includes('delete') && (!session || !session.user || user.email
                                    !==session.user.email)) { %>
                                    <li>
                                      <a href="#" class="remove" title="Delete User" data-id="<%= user._id %>"
                                        data-bs-toggle="modal" data-bs-target="#modal-delete">
                                        <i class="uil uil-trash-alt"></i>
                                      </a>
                                    </li>
                                    <% } %>
                        </ul>
                      </td>
                    </tr>
                    <% }) %>
                      <% } else { %>
                        <tr>
                          <td colspan="11" class="text-center">No users found</td>
                        </tr>
                        <% } %>
              </tbody>
            </table>
          </div>
          <div class="d-flex justify-content-between align-items-center pt-30">
            <div class="pagination-info">
              Showing <%= ((currentPage - 1) * limit) + 1 %> to <%= Math.min(currentPage * limit, total || 0) %> of <%=
                    total || 0 %> Users
            </div>
            <nav class="dm-page">
              <ul class="dm-pagination d-flex">
                <li class="dm-pagination__item">
                  <% if (totalPages> 1) { %>
                    <% if (currentPage> 1) { %>
                      <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                        class="dm-pagination__link">
                        <span class="la la-angle-left"></span>
                      </a>
                      <% } %>

                        <% for (let i=1; i <=totalPages; i++) { %>
                          <a href="?page=<%= i %>&limit=<%= limit %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                            class="dm-pagination__link <%= currentPage === i ? 'active' : '' %>">
                            <span class="page-number">
                              <%= i %>
                            </span>
                          </a>
                          <% } %>

                            <% if (currentPage < totalPages) { %>
                              <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                                class="dm-pagination__link">
                                <span class="la la-angle-right"></span>
                              </a>
                              <% } %>
                                <% } %>
                </li>
                <li class="dm-pagination__item">
                  <div class="paging-option">
                    <select name="page-number" class="page-selection">
                      <option value="5" <%=limit==5 ? 'selected' : '' %>>5/page</option>
                      <option value="10" <%=limit==10 ? 'selected' : '' %>>10/page</option>
                      <option value="20" <%=limit==20 ? 'selected' : '' %>>20/page</option>
                    </select>
                  </div>
                </li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal for Delete Confirmation -->
<div class="modal-delete modal fade" id="modal-delete" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-info" role="document">
    <div class="modal-content">
      <div class="modal-body">
        <div class="modal-info-body d-flex">
          <div class="modal-info-icon warning">
            <img src="<%- locals.base %>img/svg/alert-circle.svg" alt="alert-circle" class="svg">
          </div>
          <div class="modal-info-text">
            <h6>Do you want to delete this user?</h6>
            <p>This action cannot be undone.</p>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-outlined btn-sm" data-bs-dismiss="modal">No</button>
        <form id="modalDeleteForm" method="POST" class="d-inline">
          <button type="submit" class="btn btn-success btn-outlined btn-sm">Yes</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modal for Export Confirmation -->
<div class="modal-export modal fade" id="modal-export" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-info" role="document">
    <div class="modal-content">
      <div class="modal-body">
        <div class="modal-info-body d-flex">
          <div class="modal-info-icon success">
            <img src="<%- locals.base %>img/svg/check-circle.svg" alt="check-circle" class="svg">
          </div>
          <div class="modal-info-text">
            <h6>Export Data Pengguna</h6>
            <p>Pilih format file untuk diekspor:</p>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <a href="#" class="btn btn-success btn-sm" id="excel"><i class="uil uil-file-download"></i>Excel</a>
        <a href="#" class="btn btn-primary btn-sm" id="csv"><i class="uil uil-file-download"></i>CSV</a>
        <button type="button" class="btn btn-light btn-outlined btn-sm" data-bs-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>


<!-- Modal for Adding Users -->
<div class="modal-tambah-users modal fade show" id="modal-tambah-users" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content modal-bg-white">
      <form method="POST" action="<%= locals.base %>settings/users/create/<%- locale %>" enctype="multipart/form-data">
        <div class="modal-header">
          <h6 class="modal-title">Add New User</h6>
          <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
            <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg">
          </button>
        </div>
        <div class="modal-body">
          <!-- Username -->
          <div class="mb-3">
            <label for="username" class="form-label">Username <span class="text-danger">*</span></label>
            <input type="text" class="form-control <%= locals.errors && errors.username ? 'is-invalid' : '' %>"
              id="username" name="username" value="<%= locals.input ? input.username : '' %>"
              placeholder="Enter username" required minlength="3">
            <% if (locals.errors && errors.username) { %>
              <div class="invalid-feedback">
                <%= errors.username.message %>
              </div>
              <% } %>
          </div>

          <!-- First Name & Last Name -->
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="firstname" class="form-label">First Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control <%= locals.errors && errors.firstname ? 'is-invalid' : '' %>"
                id="firstname" name="firstname" value="<%= locals.input ? input.firstname : '' %>"
                placeholder="Enter first name" required>
              <% if (locals.errors && errors.firstname) { %>
                <div class="invalid-feedback">
                  <%= errors.firstname.message %>
                </div>
                <% } %>
            </div>
            <div class="col-md-6 mb-3">
              <label for="lastname" class="form-label">Last Name</label>
              <input type="text" class="form-control" id="lastname" name="lastname"
                value="<%= locals.input ? input.lastname : '' %>" placeholder="Enter last name">
            </div>
          </div>

          <!-- Email -->
          <div class="mb-3">
            <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
            <input type="email" class="form-control <%= locals.errors && errors.email ? 'is-invalid' : '' %>" id="email"
              name="email" value="<%= locals.input ? input.email : '' %>" placeholder="Enter email address" required>
            <% if (locals.errors && errors.email) { %>
              <div class="invalid-feedback">
                <%= errors.email.message %>
              </div>
              <% } %>
          </div>

          <!-- Phone Number -->
          <div class="mb-3">
            <label for="phoneNumber" class="form-label">Phone Number (WhatsApp)</label>
            <div class="input-group">
              <span class="input-group-text">+62</span>
              <input type="text" class="form-control <%= locals.errors && errors.phoneNumber ? 'is-invalid' : '' %>"
                id="phoneNumber" name="phoneNumber" value="<%= locals.input ? input.phoneNumber : '' %>"
                placeholder="812XXXXXXXX">
            </div>
            <% if (locals.errors && errors.phoneNumber) { %>
              <div class="invalid-feedback">
                <%= errors.phoneNumber.message %>
              </div>
              <% } %>
          </div>

          <!-- Password -->
          <div class="mb-3">
            <label for="password" class="form-label">Password <span class="text-danger">*</span></label>
            <div class="input-group">
              <input type="password" class="form-control <%= locals.errors && errors.password ? 'is-invalid' : '' %>"
                id="password" name="password" placeholder="Enter password" required>
              <a class="input-group-text" id="togglePassword">
                <i class="las la-eye"></i>
              </a>
            </div>
            <% if (locals.errors && errors.password) { %>
              <div class="invalid-feedback">
                <%= errors.password.message %>
              </div>
              <% } %>
                <div class="form-text">Minimum 8 characters, with uppercase, lowercase, numbers, and symbols.</div>
                <div class="password-strength mt-2" id="passwordStrength" style="display: none;">
                  <div class="progress" style="height: 5px;">
                    <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                  </div>
                  <small class="text-muted">Password strength: <span id="strengthText">Weak</span></small>
                </div>
          </div>

          <!-- Photo Profile -->
          <div class="mb-3">
            <label for="photoProfile" class="form-label">Photo Profile</label>
            <input class="form-control" type="file" id="photoProfile" name="photoProfile"
              accept="image/png, image/jpeg, image/jpg">
            <div class="form-text">Max file size 2MB. Allowed formats: JPG, JPEG, PNG.</div>
            <img id="photoPreview" src="#" alt="Image Preview" class="mt-2"
              style="display: none; max-width: 100px; border-radius: 5px;" />
          </div>

          <!-- Level (Pusat/Cabang) -->
          <div class="mb-3">
            <label for="level" class="form-label">User Level <span class="text-danger">*</span></label>
            <select class="form-control <%= locals.errors && errors.level ? 'is-invalid' : '' %>" id="level"
              name="level" required>
              <option value="Cabang" <%=(locals.input && input.level==='Cabang' ) ? 'selected' : '' %>>Cabang</option>
              <option value="Pusat" <%=(locals.input && input.level==='Pusat' ) ? 'selected' : '' %>>Pusat</option>
            </select>
            <% if (locals.errors && errors.level) { %>
              <div class="invalid-feedback">
                <%= errors.level.message %>
              </div>
              <% } %>
                <div class="form-text">Pusat users don't need to select branch.</div>
          </div>

          <!-- Branch -->
          <div class="mb-3" id="branch-selection">
            <label for="branch_id" class="form-label">Branch <span class="text-danger">*</span></label>
            <select class="form-control <%= locals.errors && errors.branch_id ? 'is-invalid' : '' %>" id="branch_id"
              name="branch_id" required>
              <option value="">Select Branch</option>
              <% branches.forEach(branch=> { %>
                <% if(branch.type !=='pusat' ) { %>
                  <option value="<%= branch._id %>" <%=(locals.input && input.branch_id==branch._id) ? 'selected' : ''
                    %>>
                    <%= branch.name %>
                  </option>
                  <% } %>
                    <% }) %>
            </select>
            <% if (locals.errors && errors.branch_id) { %>
              <div class="invalid-feedback">
                <%= errors.branch_id.message %>
              </div>
              <% } %>
          </div>

          <!-- Division -->
          <div class="mb-3">
            <label for="division_id" class="form-label">Division <span class="text-danger">*</span></label>
            <select class="form-control <%= locals.errors && errors.division_id ? 'is-invalid' : '' %>" id="division_id"
              name="division_id" required>
              <option value="">Select Division</option>
              <% divisions.forEach(division=> { %>
                <option value="<%= division._id %>" <%=(locals.input && input.division_id==division._id) ? 'selected'
                  : '' %>>
                  <%= division.name %>
                </option>
                <% }) %>
            </select>
            <% if (locals.errors && errors.division_id) { %>
              <div class="invalid-feedback">
                <%= errors.division_id.message %>
              </div>
              <% } %>
          </div>

          <!-- Position -->
          <div class="mb-3">
            <label for="position_id" class="form-label">Position <span class="text-danger">*</span></label>
            <select class="form-control <%= locals.errors && errors.position_id ? 'is-invalid' : '' %>" id="position_id"
              name="position_id" required>
              <option value="">Select Position</option>
              <% positions.forEach(position=> { %>
                <option value="<%= position._id %>" <%=(locals.input && input.position_id==position._id) ? 'selected'
                  : '' %>>
                  <%= position.name %> (Level <%= position.level %>)
                </option>
                <% }) %>
            </select>
            <% if (locals.errors && errors.position_id) { %>
              <div class="invalid-feedback">
                <%= errors.position_id.message %>
              </div>
              <% } %>
          </div>

          <!-- Status -->
          <div class="mb-3">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" id="isActive" name="isActive" <%=(!locals.input ||
                (locals.input && input.isActive==='on' )) ? 'checked' : '' %>>
              <label class="form-check-label" for="isActive">Active Status</label>
            </div>
            <div class="form-text">Active users can login to the system</div>
          </div>

          <!-- Role Info -->
          <div class="alert alert-info">
            <i class="las la-info-circle"></i>
            The system will automatically assign or create a role based on the selected Level, Branch, Division, and
            Position combination.
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">
            <i class="las la-save"></i> Create User
          </button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal for Editing Users -->
<div class="modal-edit-users modal fade" id="modal-edit-users" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content modal-bg-white">
      <form method="POST" action="" id="editUserForm" enctype="multipart/form-data">
        <input type="hidden" name="_method" value="PUT" />
        <div class="modal-header">
          <h6 class="modal-title">Edit User</h6>
          <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
            <img src="<%- locals.base %>img/svg/x.svg" alt="x" class="svg">
          </button>
        </div>
        <div class="modal-body">
          <!-- Username -->
          <div class="mb-3">
            <label for="edit-username" class="form-label">Username <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="edit-username" name="username" required minlength="3">
          </div>

          <!-- First Name & Last Name -->
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="edit-firstname" class="form-label">First Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="edit-firstname" name="firstname" required>
            </div>
            <div class="col-md-6 mb-3">
              <label for="edit-lastname" class="form-label">Last Name</label>
              <input type="text" class="form-control" id="edit-lastname" name="lastname">
            </div>
          </div>

          <!-- Email -->
          <div class="mb-3">
            <label for="edit-email" class="form-label">Email Address <span class="text-danger">*</span></label>
            <input type="email" class="form-control" id="edit-email" name="email" required>
          </div>

          <!-- Phone Number -->
          <div class="mb-3">
            <label for="edit-phoneNumber" class="form-label">Phone Number (WhatsApp)</label>
            <div class="input-group">
              <span class="input-group-text">+62</span>
              <input type="text" class="form-control" id="edit-phoneNumber" name="phoneNumber"
                placeholder="812XXXXXXXX">
            </div>
          </div>

          <!-- Password -->
          <div class="mb-3">
            <label for="edit-password" class="form-label">Password</label>
            <div class="input-group">
              <input type="password" class="form-control" id="edit-password" name="password"
                placeholder="Leave blank to keep current password">
              <a class="input-group-text" id="edit-togglePassword">
                <i class="las la-eye"></i>
              </a>
            </div>
            <div class="form-text">Leave blank if you don't want to change the password.</div>
          </div>

          <!-- Photo Profile -->
          <div class="mb-3">
            <label for="edit-photoProfile" class="form-label">Photo Profile</label>
            <input class="form-control" type="file" id="edit-photoProfile" name="photoProfile"
              accept="image/png, image/jpeg, image/jpg">
            <div class="form-text">Max file size 2MB. Leave blank to keep current photo.</div>
            <img id="edit-photoPreview" src="#" alt="Image Preview" class="mt-2"
              style="max-width: 100px; border-radius: 5px;" />
          </div>

          <!-- Level (Pusat/Cabang) -->
          <div class="mb-3">
            <label for="edit-level" class="form-label">User Level <span class="text-danger">*</span></label>
            <select class="form-control" id="edit-level" name="level" required>
              <option value="Cabang">Cabang</option>
              <option value="Pusat">Pusat</option>
            </select>
          </div>

          <!-- Branch -->
          <div class="mb-3" id="edit-branch-selection">
            <label for="edit-branch_id" class="form-label">Branch <span class="text-danger">*</span></label>
            <select class="form-control" id="edit-branch_id" name="branch_id" required>
              <option value="">Select Branch</option>
              <% branches.forEach(branch=> { %>
                <% if(branch.type !=='pusat' ) { %>
                  <option value="<%= branch._id %>">
                    <%= branch.name %>
                  </option>
                  <% } %>
                    <% }) %>
            </select>
          </div>

          <!-- Division -->
          <div class="mb-3">
            <label for="edit-division_id" class="form-label">Division <span class="text-danger">*</span></label>
            <select class="form-control" id="edit-division_id" name="division_id" required>
              <option value="">Select Division</option>
              <% divisions.forEach(division=> { %>
                <option value="<%= division._id %>">
                  <%= division.name %>
                </option>
                <% }) %>
            </select>
          </div>

          <!-- Position -->
          <div class="mb-3">
            <label for="edit-position_id" class="form-label">Position <span class="text-danger">*</span></label>
            <select class="form-control" id="edit-position_id" name="position_id" required>
              <option value="">Select Position</option>
              <% positions.forEach(position=> { %>
                <option value="<%= position._id %>">
                  <%= position.name %> (Level <%= position.level %>)
                </option>
                <% }) %>
            </select>
          </div>

          <!-- Active Status -->
          <div class="mb-3">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" id="edit-isActive" name="isActive">
              <label class="form-check-label" for="edit-isActive">Active Status</label>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">
            <i class="las la-save"></i> Update User
          </button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Handle Delete
  document.querySelectorAll('.remove').forEach(btn => {
    btn.addEventListener('click', function () {
      const userId = this.getAttribute('data-id');
      const form = document.getElementById('modalDeleteForm');
      form.action = "<%= locals.base %>settings/users/delete/" + userId + "/<%- locale %>";
      form.method = "POST";
    });
  });

  // Handle pagination limit change
  document.querySelector('.page-selection').addEventListener('change', function () {
    const selectedLimit = this.value;
    const params = new URLSearchParams(window.location.search);
    params.set('limit', selectedLimit);
    params.set('page', 1);
    window.location.href = `${window.location.pathname}?${params.toString()}`;
  });

  // Handle filters
  const filterLevel = document.getElementById('filterLevel');
  const filterBranch = document.getElementById('filterBranch');
  const filterStatus = document.getElementById('filterStatus');
  const resetFilters = document.getElementById('resetFilters');

  function applyFilters() {
    const params = new URLSearchParams(window.location.search);

    if (filterLevel.value) params.set('level', filterLevel.value);
    else params.delete('level');

    if (filterBranch.value) params.set('branch', filterBranch.value);
    else params.delete('branch');

    if (filterStatus.value) params.set('isActive', filterStatus.value);
    else params.delete('isActive');

    params.set('page', 1);
    window.location.href = `${window.location.pathname}?${params.toString()}`;
  }

  filterLevel.addEventListener('change', applyFilters);
  filterBranch.addEventListener('change', applyFilters);
  filterStatus.addEventListener('change', applyFilters);

  resetFilters.addEventListener('click', function () {
    window.location.href = window.location.pathname;
  });

  // Handle level-branch relationship for create modal
  const levelSelect = document.getElementById('level');
  const branchSelection = document.getElementById('branch-selection');
  const branchSelect = document.getElementById('branch_id');

  levelSelect.addEventListener('change', function () {
    if (this.value === 'Pusat') {
      branchSelection.style.display = 'none';
      branchSelect.required = false;
      branchSelect.value = '';
    } else {
      branchSelection.style.display = 'block';
      branchSelect.required = true;
    }
  });

  // Photo preview
  const photoInput = document.getElementById('photoProfile');
  const photoPreview = document.getElementById('photoPreview');

  photoInput.addEventListener('change', function () {
    const [file] = this.files;
    if (file) {
      // Validate file size (2MB)
      if (file.size > 2 * 1024 * 1024) {
        alert('File size must be less than 2MB');
        this.value = '';
        return;
      }

      // Validate file type
      const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
      if (!allowedTypes.includes(file.type)) {
        alert('Only JPG, JPEG, and PNG files are allowed');
        this.value = '';
        return;
      }

      photoPreview.style.display = 'block';
      photoPreview.src = URL.createObjectURL(file);
    }
  });

  // Password strength meter
  const passwordInput = document.getElementById('password');
  const passwordStrength = document.getElementById('passwordStrength');
  const strengthBar = passwordStrength.querySelector('.progress-bar');
  const strengthText = document.getElementById('strengthText');
  const togglePassword = document.getElementById('togglePassword');

  // Toggle password visibility
  togglePassword.addEventListener('click', function () {
    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
    passwordInput.setAttribute('type', type);
    this.querySelector('i').classList.toggle('la-eye');
    this.querySelector('i').classList.toggle('la-eye-slash');
  });

  // Password strength calculation
  passwordInput.addEventListener('input', function () {
    const password = this.value;
    if (password.length > 0) {
      passwordStrength.style.display = 'block';
      const strength = calculatePasswordStrength(password);

      strengthBar.style.width = strength.score + '%';
      strengthBar.className = 'progress-bar ' + strength.color;
      strengthText.textContent = strength.text;
    } else {
      passwordStrength.style.display = 'none';
    }
  });

  function calculatePasswordStrength(password) {
    let score = 0;
    let text = 'Weak';
    let color = 'bg-danger';

    // Length
    if (password.length >= 8) score += 20;
    if (password.length >= 12) score += 10;

    // Contains lowercase
    if (/[a-z]/.test(password)) score += 20;

    // Contains uppercase
    if (/[A-Z]/.test(password)) score += 20;

    // Contains numbers
    if (/\d/.test(password)) score += 20;

    // Contains special characters
    if (/[!@#$%^&*(),.?":{}|<>]/.test(password)) score += 10;

    // Determine strength text and color
    if (score < 40) {
      text = 'Weak';
      color = 'bg-danger';
    } else if (score < 60) {
      text = 'Fair';
      color = 'bg-warning';
    } else if (score < 80) {
      text = 'Good';
      color = 'bg-info';
    } else {
      text = 'Strong';
      color = 'bg-success';
    }

    return { score, text, color };
  }

  // Edit modal handling
  const editLevelSelect = document.getElementById('edit-level');
  const editBranchSelection = document.getElementById('edit-branch-selection');
  const editBranchSelect = document.getElementById('edit-branch_id');
  const editPhotoInput = document.getElementById('edit-photoProfile');
  const editPhotoPreview = document.getElementById('edit-photoPreview');
  const editPasswordInput = document.getElementById('edit-password');
  const editTogglePassword = document.getElementById('edit-togglePassword');

  // Toggle password visibility for edit modal
  editTogglePassword.addEventListener('click', function () {
    const type = editPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
    editPasswordInput.setAttribute('type', type);
    this.querySelector('i').classList.toggle('la-eye');
    this.querySelector('i').classList.toggle('la-eye-slash');
  });

  function toggleEditBranch(level) {
    if (level === 'Pusat') {
      editBranchSelection.style.display = 'none';
      editBranchSelect.required = false;
      editBranchSelect.value = '';
    } else {
      editBranchSelection.style.display = 'block';
      editBranchSelect.required = true;
    }
  }

  editLevelSelect.addEventListener('change', function () {
    toggleEditBranch(this.value);
  });

  editPhotoInput.addEventListener('change', function () {
    const [file] = this.files;
    if (file) {
      // Validate file size and type
      if (file.size > 2 * 1024 * 1024) {
        alert('File size must be less than 2MB');
        this.value = '';
        return;
      }

      const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png'];
      if (!allowedTypes.includes(file.type)) {
        alert('Only JPG, JPEG, and PNG files are allowed');
        this.value = '';
        return;
      }

      editPhotoPreview.style.display = 'block';
      editPhotoPreview.src = URL.createObjectURL(file);
    }
  });

  // Populate edit modal
  document.querySelectorAll('.edit').forEach(btn => {
    btn.addEventListener('click', function () {
      const id = this.dataset.id;
      const username = this.dataset.username;
      const firstname = this.dataset.firstname;
      const lastname = this.dataset.lastname;
      const email = this.dataset.email;
      const phoneNumber = this.dataset.phonenumber;
      const photo = this.dataset.photo;
      const level = this.dataset.level || (this.dataset.status === 'true' ? 'Pusat' : 'Cabang');
      const branch = this.dataset.branch;
      const division = this.dataset.division;
      const position = this.dataset.position;
      const isActive = this.dataset.active === 'true';

      const form = document.getElementById('editUserForm');
      form.action = `<%= locals.base %>settings/users/update/${id}/<%- locale %>?_method=POST`;

      document.getElementById('edit-username').value = username;
      document.getElementById('edit-firstname').value = firstname;
      document.getElementById('edit-lastname').value = lastname;
      document.getElementById('edit-email').value = email;
      document.getElementById('edit-phoneNumber').value = phoneNumber ? phoneNumber.replace('+62', '') : '';
      document.getElementById('edit-password').value = '';
      document.getElementById('edit-level').value = level;
      document.getElementById('edit-division_id').value = division;
      document.getElementById('edit-position_id').value = position;
      document.getElementById('edit-isActive').checked = isActive;

      if (photo) {
        editPhotoPreview.style.display = 'block';
        editPhotoPreview.src = `<%- locals.base %>${photo}`;
      } else {
        editPhotoPreview.style.display = 'none';
      }

      toggleEditBranch(level);
      if (level === 'Cabang') {
        document.getElementById('edit-branch_id').value = branch;
      }
    });
  });

  // Handle status toggle
  document.querySelectorAll('.status-toggle').forEach(btn => {
    btn.addEventListener('click', async function (e) {
      e.preventDefault();

      const userId = this.dataset.id;
      const currentStatus = this.dataset.status === 'true';

      if (!confirm(`Are you sure you want to ${currentStatus ? 'deactivate' : 'activate'} this user?`)) {
        return;
      }

      try {
        const response = await fetch(`<%= locals.base %>settings/users/api/toggle-status/${userId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          }
        });

        const result = await response.json();

        if (result.success) {
          // Reload page to show updated status
          location.reload();
        } else {
          alert(result.message || 'Failed to update user status');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('An error occurred while updating user status');
      }
    });
  });

  // Form validation
  document.querySelectorAll('form').forEach(form => {
    form.addEventListener('submit', function (e) {
      const phoneInputs = this.querySelectorAll('input[name="phoneNumber"]');
      phoneInputs.forEach(input => {
        if (input.value) {
          // Clean phone number format
          let phone = input.value.replace(/[^0-9+]/g, '');
          if (!phone.startsWith('+62') && phone.length > 0) {
            phone = '+62' + phone;
          }
          input.value = phone;
        }
      });
    });
  });

  document.addEventListener('DOMContentLoaded', function () {
    const excelBtn = document.getElementById('excel');
    const csvBtn = document.getElementById('csv');

    function updateExportLinks() {
      const filterLevel = document.getElementById('filterLevel').value;
      const filterBranch = document.getElementById('filterBranch').value;
      const filterStatus = document.getElementById('filterStatus').value;
      const queryString = `?filterLevel=${filterLevel}&filterBranch=${filterBranch}&filterStatus=${filterStatus}`;

      excelBtn.href = `<%= locals.base %>settings/users/export/excel/<%- locale %>${queryString}`;
      csvBtn.href = `<%= locals.base %>settings/users/export/csv/<%- locale %>${queryString}`;
    }

    document.getElementById('filterLevel').addEventListener('change', updateExportLinks);
    document.getElementById('filterBranch').addEventListener('change', updateExportLinks);
    document.getElementById('filterStatus').addEventListener('change', updateExportLinks);
    updateExportLinks();
  });

  // Initialize tooltips
  var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
  var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl);
  });
</script>